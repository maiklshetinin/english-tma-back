{
  "name": "tutor-tma-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file=.env index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx login.test.ts && tsx students.test.ts && tsx schedule.test.ts && tsx clean.test.ts && tsx content.test.ts && tsx srs.test.ts"
  },
  "dependencies": { "cors": "^2.8.5", "express": "^4.21.2", "firebase-admin": "^13.0.0" },
  "devDependencies": { "@types/cors": "^2.8.17", "@types/express": "^4.17.21", "@types/node": "^22.10.0", "tsx": "^4.19.2", "typescript": "^5.7.2" }
}
